# ==========================================
# EXPENSE TRACKER - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and replace with your actual values
# ==========================================


#active profile

SPRING_PROFILES_ACTIVE=local

# JWT Secret Key (generate a strong 256-bit key for production)
SECURITY_SECRET_KEY=your_jwt_secret_key_here

# Database Configuration
DB_NAME=expense-db
DB_USER=user
DB_PASSWORD=your_database_password_here
DB_ROOT_PASSWORD=your_database_root_password_here

# SSL Keystore Password (required when running with SSL / HTTPS)
SSL_KEYSTORE_PASSWORD=your_ssl_keystore_password_here

# Optional Configurations
# PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
# JPA_SHOW_SQL=false
